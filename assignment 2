# ==============================================================================
# 1. TOKENISATION, VOCABULARY & <UNK> MAPPING (TASK 1)
# ==============================================================================
def tokenize_utterance(utterance: str):
    """Lowercases text, keeps time (6:30) & date (15/11/2026) intact, adds <s> and </s>."""
    tokens = re.findall(r"[a-z0-9]+(?:[:/][a-z0-9]+)*", utterance.lower())
    return ["<s>"] + tokens + ["</s>"]

def build_vocabulary(train_tokens, min_freq: int = 2):
    counts = Counter(train_tokens)
    vocab = {w for w, c in counts.items() if c >= min_freq}
    vocab.add("<UNK>")
    return vocab

def apply_unk(tokens, vocab):
    return [t if t in vocab else "<UNK>" for t in tokens]

# ==============================================================================
# 2. N-GRAM LANGUAGE MODELS: UNSMOOTHED, ADD-K, GOOD-TURING, KATZ & INTERPOLATION
# ==============================================================================
class NgramLanguageModel:
    def __init__(self, vocab):
        self.vocab = vocab
        self.V = len(vocab)
        self.unigram_counts = Counter()
        self.bigram_counts = Counter()
        self.trigram_counts = Counter()
        self.total_tokens = 0
        self.gt_bigram_cstar = {}
        self.p_unseen_bigram = 0.0
        self.lambdas = (0.15, 0.30, 0.55)

    def train(self, tokenized_utterances):
        for utt in tokenized_utterances:
            seq = apply_unk(utt, self.vocab)
            self.total_tokens += len(seq)
            for i, w in enumerate(seq):
                self.unigram_counts[w] += 1
                if i >= 1:
                    self.bigram_counts[(seq[i-1], w)] += 1
                if i >= 2:
                    self.trigram_counts[(seq[i-2], seq[i-1], w)] += 1
        self._compute_good_turing()

    def _compute_good_turing(self):
        freq_of_freq = Counter(self.bigram_counts.values())
        N1 = freq_of_freq.get(1, 1)
        total_bigrams = sum(self.bigram_counts.values())
        possible_unseen = max(1, (self.V * self.V) - len(self.bigram_counts))
        self.p_unseen_bigram = (N1 / total_bigrams) / possible_unseen
        for bg, c in self.bigram_counts.items():
            if c >= 5:
                self.gt_bigram_cstar[bg] = float(c)
            else:
                nc = freq_of_freq[c]
                nc1 = freq_of_freq.get(c + 1, nc)
                self.gt_bigram_cstar[bg] = (c + 1) * (nc1 / nc)

    def prob_unsmoothed_bigram(self, w1, w2):
        c1 = self.unigram_counts[w1]
        return (self.bigram_counts[(w1, w2)] / c1) if c1 > 0 else 0.0

    def prob_add_k_bigram(self, w1, w2, k=0.1):
        return (self.bigram_counts[(w1, w2)] + k) / (self.unigram_counts[w1] + k * self.V)

    def prob_good_turing_bigram(self, w1, w2):
        c1 = self.unigram_counts[w1]
        if c1 == 0:
            return 1.0 / self.V
        bg = (w1, w2)
        if bg in self.gt_bigram_cstar:
            return self.gt_bigram_cstar[bg] / c1
        return self.p_unseen_bigram

    def prob_katz_backoff_trigram(self, w1, w2, w3):
        c123 = self.trigram_counts[(w1, w2, w3)]
        c12 = self.bigram_counts[(w1, w2)]
        if c123 > 0 and c12 > 0:
            return max(c123 - 0.75, 0.0) / c12
        seen_followers = [w for (a, b, w) in self.trigram_counts if a == w1 and b == w2]
        beta = 1.0 - sum(max(self.trigram_counts[(w1, w2, w)] - 0.75, 0.0) / c12 for w in seen_followers) if c12 > 0 else 1.0
        denom = max(1e-9, 1.0 - sum(self.prob_good_turing_bigram(w2, w) for w in seen_followers))
        alpha = beta / denom
        return alpha * self.prob_good_turing_bigram(w2, w3)

    def prob_deleted_interpolation(self, w1, w2, w3, l1=0.12, l2=0.33, l3=0.55):
        p1 = self.unigram_counts[w3] / max(1, self.total_tokens)
        p2 = (self.bigram_counts[(w2, w3)] / self.unigram_counts[w2]) if self.unigram_counts[w2] > 0 else p1
        p3 = (self.trigram_counts[(w1, w2, w3)] / self.bigram_counts[(w1, w2)]) if self.bigram_counts[(w1, w2)] > 0 else p2
        return l1 * p1 + l2 * p2 + l3 * p3

    def perplexity(self, tokenized_utterances, mode="interp"):
        log_prob_sum = 0.0
        N = 0
        for utt in tokenized_utterances:
            seq = apply_unk(utt, self.vocab)
            for i in range(2, len(seq)):
                w1, w2, w3 = seq[i-2], seq[i-1], seq[i]
                if mode == "add_k":
                    p = self.prob_add_k_bigram(w2, w3, k=0.1)
                elif mode == "gt":
                    p = self.prob_good_turing_bigram(w2, w3)
                elif mode == "katz":
                    p = self.prob_katz_backoff_trigram(w1, w2, w3)
                else:
                    p = self.prob_deleted_interpolation(w1, w2, w3)
                log_prob_sum += math.log2(max(p, 1e-12))
                N += 1
        cross_entropy = -log_prob_sum / max(1, N)
        return cross_entropy, 2 ** cross_entropy

    def rescore_hypotheses(self, hypotheses_list):
        best_utt, best_score = None, -1e18
        for hyp in hypotheses_list:
            seq = apply_unk(tokenize_utterance(hyp), self.vocab)
            score = 0.0
            for i in range(2, len(seq)):
                score += math.log(max(self.prob_deleted_interpolation(seq[i-2], seq[i-1], seq[i]), 1e-12))
            if score > best_score:
                best_score, best_utt = score, hyp
        return best_utt

