# 3. THREE POS TAGGERS: RULE-BASED, HMM VITERBI, AND BRILL TBL (TASKS 7-9)
# ==============================================================================
DOMAIN_LEXICON_TAGS = {
    "to": ["TO"], "from": ["IN"], "at": ["IN"], "on": ["IN"], "for": ["IN"], "in": ["IN"],
    "the": ["DT"], "a": ["DT"], "an": ["DT"], "this": ["DT"], "my": ["PRP$"],
    "i": ["PRP"], "you": ["PRP"], "it": ["PRP"],
    "two": ["CD"], "one": ["CD"], "three": ["CD"], "2": ["CD"], "3": ["CD"],
    "chennai": ["NNP"], "vellore": ["NNP"], "madurai": ["NNP"], "coimbatore": ["NNP"],
    "tickets": ["NNS"], "ticket": ["NN"], "bus": ["NN"], "train": ["NN"], "fare": ["NN"],
    "express": ["JJ", "NN"], "sleeper": ["NN", "JJ"], "timing": ["NN"], "refund": ["NN", "VB"],
    "book": ["VB", "NN"], "return": ["NN", "VB"], "stand": ["NN", "VB"],
    "cancel": ["VB"], "want": ["VBP"], "get": ["VB"], "stop": ["VB", "NN"],
    "what": ["WP"], "when": ["WRB"], "how": ["WRB"], "can": ["MD"], "does": ["VBZ"],
    "please": ["UH"], "uh": ["UH"], "um": ["UH"]
}

def rule_based_tagger(tokens):
    """Two-stage tagger: dictionary lookup + contextual disambiguation rules."""
    tags = [DOMAIN_LEXICON_TAGS.get(w.lower(), ["NN"])[0] for w in tokens]
    for i, w in enumerate(tokens):
        wl = w.lower()
        prev_t = tags[i-1] if i > 0 else "BOS"
        next_w = tokens[i+1].lower() if i + 1 < len(tokens) else "EOS"
        if wl == "book":
            tags[i] = "VB" if prev_t in ("TO", "MD", "UH", "BOS") else "NN"
        elif wl == "return":
            tags[i] = "JJ" if next_w in ("ticket", "tickets", "fare") else ("VB" if prev_t in ("TO", "MD") else "NN")
        elif wl == "stand":
            tags[i] = "NN" if prev_t in ("NN", "DT") else "VB"
        elif re.match(r"^\d{1,2}:\d{2}$", wl):
            tags[i] = "TIME"
        elif re.match(r"^\d{2}/\d{2}/\d{4}$", wl):
            tags[i] = "DATE"
    return list(zip(tokens, tags))

class HMMViterbiTagger:
    def __init__(self):
        self.transitions = defaultdict(Counter)
        self.emissions = defaultdict(Counter)
        self.tag_counts = Counter()
        self.tags = set()

    def train(self, tagged_sentences):
        for sent in tagged_sentences:
            prev = "<s>"
            self.tag_counts[prev] += 1
            for word, tag in sent:
                wl = word.lower()
                self.tags.add(tag)
                self.transitions[prev][tag] += 1
                self.emissions[tag][wl] += 1
                self.tag_counts[tag] += 1
                prev = tag
            self.transitions[prev]["</s>"] += 1

    def _emit_prob(self, tag, word):
        wl = word.lower()
        V_emit = len(self.emissions[tag]) + 50
        if wl in self.emissions[tag]:
            return (self.emissions[tag][wl] + 0.1) / (self.tag_counts[tag] + 0.1 * V_emit)
        if re.match(r"^\d{1,2}:\d{2}$", wl) and tag == "TIME":
            return 0.85
        if re.match(r"^\d{2}/\d{2}/\d{4}$", wl) and tag == "DATE":
            return 0.85
        if word[0].isupper() and tag == "NNP":
            return 0.65
        if wl.endswith("ing") and tag == "VBG":
            return 0.50
        if wl.endswith("s") and tag == "NNS":
            return 0.45
        return 0.05 / (self.tag_counts[tag] + 0.1 * V_emit)

    def viterbi_decode(self, tokens):
        states = sorted(list(self.tags))
        T = len(tokens)
        dp = [{} for _ in range(T)]
        backptr = [{} for _ in range(T)]
        V_tags = len(states) + 1

        for s in states:
            p_trans = (self.transitions["<s>"][s] + 0.1) / (self.tag_counts["<s>"] + 0.1 * V_tags)
            dp[0][s] = math.log(p_trans) + math.log(self._emit_prob(s, tokens[0]))
            backptr[0][s] = "<s>"

        for t in range(1, T):
            for s in states:
                emit_lp = math.log(self._emit_prob(s, tokens[t]))
                best_val, best_prev = -1e18, None
                for sp in states:
                    p_tr = (self.transitions[sp][s] + 0.1) / (self.tag_counts[sp] + 0.1 * V_tags)
                    val = dp[t-1][sp] + math.log(p_tr) + emit_lp
                    if val > best_val:
                        best_val, best_prev = val, sp
                dp[t][s] = best_val
                backptr[t][s] = best_prev

        best_last = max(states, key=lambda s: dp[T-1][s])
        best_prob = math.exp(dp[T-1][best_last])
        seq = [best_last]
        for t in range(T-1, 0, -1):
            seq.append(backptr[t][seq[-1]])
        seq.reverse()
        return list(zip(tokens, seq)), best_prob

