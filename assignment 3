# 4. TOP-DOWN RECURSIVE DESCENT PARSER (BOUNDED DEPTH FOR LEFT RECURSION)
# ==============================================================================
def top_down_parse(tokens, grammar, lexicon, max_depth=14):
    steps = [0]
    def expand(symbols, pos, depth):
        steps[0] += 1
        if depth > max_depth:
            return []
        if not symbols:
            return [([], pos)] if pos == len(tokens) else []
        first, rest = symbols[0], symbols[1:]
        results = []
        if pos < len(tokens):
            word = tokens[pos].lower()
            for pos_tag, _ in lexicon.get(word, []):
                if pos_tag == first:
                    for sub_tree, end_pos in expand(rest, pos + 1, depth):
                        results.append(([(first, word)] + sub_tree, end_pos))
        for lhs, rhs, _ in grammar:
            if lhs == first:
                for sub_tree, end_pos in expand(rhs + rest, pos, depth + 1):
                    results.append(([(lhs, sub_tree)], end_pos))
        return results

    parses = expand(["S"], 0, 0)
    return parses, steps[0]

