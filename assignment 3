# 1. FEATURE STRUCTURES & UNIFICATION ENGINE (TASK 8)
# ==============================================================================
class UnificationFailure(Exception):
    pass

def unify(fs1, fs2):
    """Recursive attribute-value matrix (AVM) unification supporting feature paths."""
    if fs1 == fs2:
        return fs1
    if isinstance(fs1, str) and fs1.startswith("?"):
        return fs2
    if isinstance(fs2, str) and fs2.startswith("?"):
        return fs1
    if isinstance(fs1, dict) and isinstance(fs2, dict):
        result = dict(fs1)
        for k, v2 in fs2.items():
            if k in result:
                result[k] = unify(result[k], v2)
            else:
                result[k] = v2
        return result
    raise UnificationFailure(f"Cannot unify {fs1} with {fs2}")

