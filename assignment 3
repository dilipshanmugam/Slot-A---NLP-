# 5. EARLEY CHART PARSER WITH DYNAMIC PROGRAMMING & BACK-POINTERS (TASK 7)
# ==============================================================================
class EarleyState:
    def __init__(self, lhs, rhs, dot, start, end, prob=1.0, backptrs=()):
        self.lhs = lhs
        self.rhs = tuple(rhs)
        self.dot = dot
        self.start = start
        self.end = end
        self.prob = prob
        self.backptrs = backptrs

    def is_complete(self):
        return self.dot >= len(self.rhs)

    def next_cat(self):
        return self.rhs[self.dot] if not self.is_complete() else None

    def key(self):
        return (self.lhs, self.rhs, self.dot, self.start)

    def __repr__(self):
        rhs_d = list(self.rhs)
        rhs_d.insert(self.dot, "•")
        return f"[{self.lhs} -> {' '.join(rhs_d)}, ({self.start}, {self.end})]"

def earley_parse(tokens, grammar, lexicon):
    n = len(tokens)
    chart = [{} for _ in range(n + 1)]
    queues = [[] for _ in range(n + 1)]

    def enqueue(state, idx):
        k = state.key()
        if k not in chart[idx]:
            chart[idx][k] = [state]
            queues[idx].append(state)
        else:
            chart[idx][k].append(state)

    for lhs, rhs, p in grammar:
        if lhs == "S":
            enqueue(EarleyState(lhs, rhs, 0, 0, 0, p), 0)

    for i in range(n + 1):
        q_idx = 0
        while q_idx < len(queues[i]):
            state = queues[i][q_idx]
            q_idx += 1
            if not state.is_complete():
                nxt = state.next_cat()
                for lhs, rhs, p in grammar:
                    if lhs == nxt:
                        enqueue(EarleyState(lhs, rhs, 0, i, i, p), i)
                if i < n:
                    word = tokens[i].lower()
                    for pos_tag, _ in lexicon.get(word, []):
                        if pos_tag == nxt:
                            enqueue(EarleyState(nxt, [word], 1, i, i + 1, 1.0), i + 1)
            else:
                for prev_list in list(chart[state.start].values()):
                    st = prev_list[0]
                    if not st.is_complete() and st.next_cat() == state.lhs:
                        new_st = EarleyState(
                            st.lhs, st.rhs, st.dot + 1, st.start, i,
                            st.prob * state.prob, st.backptrs + (state,)
                        )
                        enqueue(new_st, i)

    completed_s = []
    for k, st_list in chart[n].items():
        if k[0] == "S" and k[2] == len(k[1]) and k[3] == 0:
            completed_s.extend(st_list)
    total_states = sum(len(c) for c in chart)
    return completed_s, total_states, chart

