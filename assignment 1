def tokenize_clinical_text(text: str):
    return [(m.lastgroup, m.group()) for m in TOKENIZER_REGEX.finditer(text)]

def normalize_clinical_text(text: str) -> str:
    text = re.sub(r"\b(\d{2})/(\d{2})/(\d{4})\b", r"\3-\2-\1", text)
    def f_to_c(m):
        val_f = float(m.group(1))
        val_c = (val_f - 32.0) * 5.0 / 9.0
        return f"{val_c:.1f} C"
    text = re.sub(r"\b(\d{2,3}(?:\.\d)?)\s?F\b", f_to_c, text)
    tokens = text.split()
    out = []
    for tok in tokens:
        clean = tok.lower().strip(",;:")
        if clean in CLINICAL_ABBREV_MAP:
            out.append(CLINICAL_ABBREV_MAP[clean])
        else:
            out.append(tok.lower())
    return " ".join(out)

