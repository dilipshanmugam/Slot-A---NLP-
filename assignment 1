DERIV_PREFIXES = {
    "hyper": "EXCESS+", "hypo": "DEFICIENT+", "re": "AGAIN+",
    "un": "NEG+", "sub": "UNDER+", "anti": "AGAINST+",
    "poly": "MANY+", "olig": "FEW+", "dys": "ABNORMAL+", "a": "WITHOUT+"
}

def apply_orthographic_rules(stem: str, suffix: str) -> str:
    if stem.endswith("y") and len(stem) > 2 and stem[-2] not in "aeiou" and suffix in ("s", "es", "ed"):
        return stem[:-1] + "ies" if suffix in ("s", "es") else stem[:-1] + "ied"
    if suffix == "s" and stem.endswith(("s", "x", "z", "ch", "sh")):
        return stem + "es"
    if stem.endswith("e") and suffix.startswith(("i", "e", "a")):
        return stem[:-1] + suffix
    if len(stem) >= 3 and stem[-1] not in "aeiouwxy" and stem[-2] in "aeiou" and stem[-3] not in "aeiou":
        if stem in ("admit", "remit", "recur", "refer") and suffix.startswith(("e", "i")):
            return stem + stem[-1] + suffix
    return stem + suffix

def morph_parse(surface_word: str):
    w = surface_word.lower()
    analyses = []
    if w in IRREGULAR_FORMS:
        analyses.extend(IRREGULAR_FORMS[w])
    if w in NOUN_STEMS:
        analyses.append(f"{w}+N+SG")
    if w in VERB_STEMS:
        analyses.append(f"{w}+V+BASE")
    if w in ADJ_STEMS:
        analyses.append(f"{w}+ADJ+POS")

    if w.endswith("ies") and len(w) > 4:
        cand = w[:-3] + "y"
        if cand in NOUN_STEMS:
            analyses.append(f"{cand}+N+PL")
    if w.endswith("es") and len(w) > 3:
        for cand in (w[:-2], w[:-1]):
            if cand in NOUN_STEMS:
                analyses.append(f"{cand}+N+PL")
            if cand in VERB_STEMS:
                analyses.append(f"{cand}+V+3SG")
    if w.endswith("s") and not w.endswith("ss") and len(w) > 2:
        cand = w[:-1]
        if cand in NOUN_STEMS:
            analyses.append(f"{cand}+N+PL")
        if cand in VERB_STEMS:
            analyses.append(f"{cand}+V+3SG")

    if w.endswith("ed") and len(w) > 3:
        cands = {w[:-2], w[:-1]}
        if len(w) > 4 and w[-3] == w[-4]:
            cands.add(w[:-3])
        for cand in cands:
            if cand in VERB_STEMS:
                analyses.append(f"{cand}+V+PAST")
    if w.endswith("ing") and len(w) > 4:
        cands = {w[:-3], w[:-3] + "e"}
        if len(w) > 5 and w[-4] == w[-5]:
            cands.add(w[:-4])
        for cand in cands:
            if cand in VERB_STEMS:
                analyses.append(f"{cand}+V+PROG")

    for pref, pfeat in DERIV_PREFIXES.items():
        if w.startswith(pref) and len(w) - len(pref) >= 4:
            rem = w[len(pref):]
            if rem in NOUN_STEMS:
                analyses.append(f"{pfeat}{rem}+N+SG")
            elif rem in ADJ_STEMS:
                analyses.append(f"{pfeat}{rem}+ADJ+POS")

    return sorted(list(set(analyses))) if analyses else [f"{w}+UNK"]

def morph_generate(lexical_form: str) -> str:
    parts = lexical_form.split("+")
    stem = parts[0]
    if len(parts) == 1:
        return stem
    pos = parts[1]
    feat = parts[2] if len(parts) > 2 else ""
    if pos == "N":
        return apply_orthographic_rules(stem, "s") if feat == "PL" else stem
    if pos == "V":
        if feat == "3SG":
            return apply_orthographic_rules(stem, "s")
        if feat == "PAST":
            return apply_orthographic_rules(stem, "ed")
        if feat == "PROG":
            return apply_orthographic_rules(stem, "ing")
    return stem

