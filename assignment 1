OCR_CONFUSION_WEIGHTS = {
    ('0', 'o'): 0.2, ('o', '0'): 0.2,
    ('1', 'l'): 0.2, ('l', '1'): 0.2,
    ('1', 'i'): 0.25, ('i', '1'): 0.25,
    ('5', 's'): 0.3, ('s', '5'): 0.3,
    ('8', 'b'): 0.3, ('b', '8'): 0.3
}

def weighted_levenshtein(s1: str, s2: str) -> float:
    m, n = len(s1), len(s2)
    dp = [[0.0] * (n + 1) for _ in range(m + 1)]
    for i in range(m + 1):
        dp[i][0] = float(i)
    for j in range(n + 1):
        dp[0][j] = float(j)
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            cost = 0.0 if s1[i-1] == s2[j-1] else OCR_CONFUSION_WEIGHTS.get((s1[i-1], s2[j-1]), 1.0)
            dp[i][j] = min(dp[i-1][j] + 1.0, dp[i][j-1] + 1.0, dp[i-1][j-1] + cost)
    return dp[m][n]

