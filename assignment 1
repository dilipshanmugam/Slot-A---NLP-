# 3. FINITE STATE AUTOMATA (DFA, EPSILON-NFA, SUBSET CONSTRUCTION) (TASK 4)
# ==============================================================================
class NFA:
    def __init__(self, states, alphabet, transitions, start, accept):
        self.states = states
        self.alphabet = alphabet
        self.transitions = transitions
        self.start = start
        self.accept = accept

    def epsilon_closure(self, state_set):
        stack = list(state_set)
        closure = set(state_set)
        while stack:
            s = stack.pop()
            for nxt in self.transitions.get((s, None), set()):
                if nxt not in closure:
                    closure.add(nxt)
                    stack.append(nxt)
        return frozenset(closure)

    def move(self, state_set, symbol):
        res = set()
        for s in state_set:
            res |= self.transitions.get((s, symbol), set())
        return res

    def accepts(self, input_str):
        current = self.epsilon_closure({self.start})
        for ch in input_str:
            sym = 'D' if ch.isdigit() else ('U' if ch in ('F', 'C') else ch)
            current = self.epsilon_closure(self.move(current, sym))
        return bool(current & self.accept)

    def to_dfa(self):
        start_dfa = self.epsilon_closure({self.start})
        unmarked = [start_dfa]
        dfa_states = {start_dfa: "D0"}
        dfa_trans = {}
        dfa_accept = set()
        while unmarked:
            curr = unmarked.pop(0)
            if curr & self.accept:
                dfa_accept.add(dfa_states[curr])
            for sym in self.alphabet:
                nxt = self.epsilon_closure(self.move(curr, sym))
                if not nxt:
                    continue
                if nxt not in dfa_states:
                    dfa_states[nxt] = f"D{len(dfa_states)}"
                    unmarked.append(nxt)
                dfa_trans[(dfa_states[curr], sym)] = dfa_states[nxt]
        return dfa_states, dfa_trans, "D0", dfa_accept

