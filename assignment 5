class ParseNode:
    def __init__(self, label, children=None, head=None, num="sg", gender="neut"):
        self.label = label
        self.children = children or []
        self.head = head
        self.num = num
        self.gender = gender

def hobbs_resolve(pronoun_num, pronoun_gender, prev_trees):
    """Simplified Hobbs breadth-first left-to-right NP search over prior parse trees."""
    for tree in reversed(prev_trees):
        queue = [tree]
        while queue:
            node = queue.pop(0)
            if node.label == "NP" and node.head:
                if node.num == pronoun_num and node.gender in (pronoun_gender, "neut"):
                    return node.head
            queue.extend(node.children)
    return "UNRESOLVED"

def centering_transitions(utterance_cf_lists):
    """Tracks Cf (salience-ranked), Cb (backward center) and Continue/Retain/Shift."""
    results = []
    prev_cb = None
    for idx, cf in enumerate(utterance_cf_lists):
        if idx == 0:
            cb = cf[0] if cf else None
            results.append((idx, cf, cb, "INIT (No prior Cb)"))
        else:
            prev_cf = utterance_cf_lists[idx - 1]
            cb = next((e for e in prev_cf if e in cf), None)
            cp = cf[0] if cf else None
            if cb == prev_cb and cb == cp:
                trans = "CONTINUE"
            elif cb == prev_cb and cb != cp:
                trans = "RETAIN"
            elif cb != prev_cb and cb == cp:
                trans = "SMOOTH-SHIFT"
            else:
                trans = "ROUGH-SHIFT"
            results.append((idx, cf, cb, trans))
        prev_cb = cb
    return results

