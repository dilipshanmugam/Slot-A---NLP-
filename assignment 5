class ShelterDialogueFrame:
    def __init__(self):
        self.slots = {"ward": None, "group_size": None, "special_need": None, "confirmed": False}

    def update(self, user_act, extracted_slots):
        if user_act == "CORRECTION":
            for k, v in extracted_slots.items():
                self.slots[k] = v
                self.slots["confirmed"] = False
            return f"Updated {list(extracted_slots.keys())}. Confirming: {self.slots}?"
        for k, v in extracted_slots.items():
            if v is not None:
                self.slots[k] = v
        if user_act == "CONFIRM":
            self.slots["confirmed"] = True
            return f"Camp Gandhi-Hall in {self.slots['ward']} is OPEN (Capacity: 120). Safe route via Main Road."
        if not self.slots["ward"]:
            return "Which ward or locality are you calling from?"
        if not self.slots["group_size"]:
            return f"Got it, {self.slots['ward']}. How many people need shelter?"
        if not self.slots["confirmed"]:
            return f"Implicitly noted {self.slots['ward']} for {self.slots['group_size']} people. Shall I lock this shelter request?"
        return "Request already confirmed."

