def generate_bulletin(incident_record, audience="citizen"):
    """Stage 1: Content Selection -> Stage 2: Discourse/Sentence Plan -> Stage 3: Surface Realisation."""
    loc = incident_record["location"]
    status = incident_record["road_status"]
    cause = incident_record["cause"]
    diversion = incident_record["diversion"]
    depth_cm = incident_record["water_depth_cm"]

    if audience == "officer":
        return (f"[INCIDENT {incident_record['id']}] {loc}: Status={status.upper()} "
                f"(Water={depth_cm}cm; Cause={cause}). Action: Divert via {diversion}.")
    s1 = f"{loc} is currently {status} due to {cause}."
    s2 = f"Because water levels on the affected stretch have reached {depth_cm} cm, motorists are advised to use {diversion}."
    return f"{s1} {s2}"

def ibm_model1_em_step(parallel_corpus, num_iters=3):
    """Runs EM iterations for IBM Model 1 word alignment probabilities t(f | e)."""
    en_vocab = {w for en, _ in parallel_corpus for w in ["NULL"] + en}
    ta_vocab = {w for _, ta in parallel_corpus for w in ta}
    t = {f: {e: 1.0 / len(ta_vocab) for e in en_vocab} for f in ta_vocab}

    for it in range(num_iters):
        count = defaultdict(lambda: defaultdict(float))
        total_e = defaultdict(float)
        for en, ta in parallel_corpus:
            en_ext = ["NULL"] + en
            for f in ta:
                z = sum(t[f][e] for e in en_ext)
                for e in en_ext:
                    delta = t[f][e] / z
                    count[f][e] += delta
                    total_e[e] += delta
        for f in ta_vocab:
            for e in en_vocab:
                t[f][e] = count[f][e] / max(1e-9, total_e[e])
    return t

