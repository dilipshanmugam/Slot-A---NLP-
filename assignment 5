# 1. DISCOURSE SEGMENTER & ENTITY-GRID COHERENCE SCORER (TASKS 1 & 3)
# ==============================================================================
CUE_PHRASES = {"because", "therefore", "however", "meanwhile", "consequently", "furthermore", "additionally", "while"}

def segment_discourse(text: str):
    """Segments multi-sentence report into Elementary Discourse Units (EDUs)."""
    sents = [s.strip() for s in re.split(r"(?<=[.!?])\s+", text.strip()) if s.strip()]
    edus = []
    for s in sents:
        parts = re.split(r"\b(because|however|while|therefore|consequently)\b", s, flags=re.I)
        buf = ""
        for p in parts:
            if p.lower() in CUE_PHRASES and buf.strip():
                edus.append(buf.strip())
                buf = p
            else:
                buf += p
        if buf.strip():
            edus.append(buf.strip())
    return edus

def entity_grid_coherence(sentences_roles):
    """Computes Barzilay & Lapata (2008) entity-grid transition probabilities (S, O, X, -)."""
    entities = sorted({e for sent in sentences_roles for e in sent})
    transitions = Counter()
    total = 0
    for ent in entities:
        for i in range(len(sentences_roles) - 1):
            r1 = sentences_roles[i].get(ent, "-")
            r2 = sentences_roles[i+1].get(ent, "-")
            transitions[(r1, r2)] += 1
            total += 1
    probs = {k: v / max(1, total) for k, v in transitions.items()}
    salient = sum(probs.get(pair, 0.0) for pair in [("S", "S"), ("S", "O"), ("O", "S"), ("O", "O")])
    return probs, salient

