# 4. SENSE-AWARE TF-IDF INVERTED INDEX & COSINE RETRIEVAL ENGINE (TASK 8)
# ==============================================================================
class CircularIRSystem:
    def __init__(self):
        self.docs = {}
        self.inverted_index = defaultdict(dict)
        self.df = Counter()
        self.N = 0
        self.doc_norms = {}

    def index_circulars(self, circulars_dict):
        self.docs = circulars_dict
        self.N = len(circulars_dict)
        for doc_id, text in circulars_dict.items():
            toks = tokenize_clean(text)
            tf_counts = Counter(toks)
            for term, c in tf_counts.items():
                self.inverted_index[term][doc_id] = 1.0 + math.log10(c)
                self.df[term] += 1

        for doc_id, text in circulars_dict.items():
            toks = set(tokenize_clean(text))
            sq_sum = 0.0
            for term in toks:
                w = self.tfidf(term, doc_id)
                sq_sum += w * w
            self.doc_norms[doc_id] = math.sqrt(sq_sum) if sq_sum > 0 else 1.0

    def idf(self, term):
        df_t = self.df.get(term, 0)
        return math.log10(self.N / df_t) if df_t > 0 else 0.0

    def tfidf(self, term, doc_id):
        tf_w = self.inverted_index.get(term, {}).get(doc_id, 0.0)
        return tf_w * self.idf(term)

    def search(self, query_text, expand_with_wsd=True, top_k=5):
        q_toks = tokenize_clean(query_text)
        if expand_with_wsd:
            for w in list(q_toks):
                if w in SENSE_INVENTORY:
                    sense_id, _ = simplified_lesk(w, query_text)
                    gloss_toks = tokenize_clean(SENSE_INVENTORY[w][sense_id])[:3]
                    q_toks.extend(gloss_toks)

        q_counts = Counter(q_toks)
        q_weights = {t: (1.0 + math.log10(c)) * self.idf(t) for t, c in q_counts.items() if t in self.df}
        q_norm = math.sqrt(sum(w * w for w in q_weights.values())) or 1.0

        scores = []
        for doc_id in self.docs:
            dot = sum(qw * self.tfidf(t, doc_id) for t, qw in q_weights.items())
            cos = dot / (q_norm * self.doc_norms[doc_id])
            scores.append((doc_id, cos))
        scores.sort(key=lambda x: -x[1])
        return scores[:top_k]

