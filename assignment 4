STOP_WORDS = {"the", "is", "a", "an", "of", "for", "to", "in", "on", "and", "or", "with", "by", "does", "every", "who"}

SENSE_INVENTORY = {
    "service": {
        "service.n.01": "period of qualifying government employment counted toward pension eligibility years",
        "service.n.02": "public administrative helpdesk assistance or counter facility provided to pensioners",
        "service.n.03": "branch or cadre of civil administration such as IAS, state secretariat or judicial service",
    },
    "dependent": {
        "dependent.n.01": "eligible family member such as unmarried daughter, minor son or spouse relying on pensioner",
        "dependent.a.01": "conditional or contingent upon another rule, circular effective date or income ceiling",
    },
    "benefit": {
        "benefit.n.01": "monetary retirement entitlement including pension, gratuity, commutation or dearness relief",
        "benefit.v.01": "to gain financial advantage or upward revision from a government notification",
    },
    "revision": {
        "revision.n.01": "periodic recalculation of basic pension following Pay Commission recommendations",
        "revision.n.02": "administrative amendment, modification or corrigendum issued to an earlier circular",
    },
    "award": {
        "award.n.01": "formal sanction order granting pension, family pension or disability compensation",
        "award.n.02": "tribunal or court judgment decreeing disputed arrears or service regularization",
    },
}

def tokenize_clean(text: str):
    return [w for w in re.findall(r"[a-z0-9]+", text.lower()) if w not in STOP_WORDS]

def simplified_lesk(target_word: str, sentence: str, use_stop_removal=True):
    """Simplified Lesk WSD algorithm comparing context overlap against sense glosses."""
    senses = SENSE_INVENTORY.get(target_word.lower(), {})
    if not senses:
        return f"{target_word}.unk", 0
    if use_stop_removal:
        context = set(tokenize_clean(sentence))
    else:
        context = set(re.findall(r"[a-z0-9]+", sentence.lower()))

    best_sense = next(iter(senses.keys()))
    max_overlap = -1
    for sense_id, gloss in senses.items():
        sig = set(tokenize_clean(gloss)) if use_stop_removal else set(re.findall(r"[a-z0-9]+", gloss.lower()))
        overlap = len(context & sig)
        if overlap > max_overlap:
            max_overlap = overlap
            best_sense = sense_id
    return best_sense, max_overlap

