# 3. FIRST-ORDER PREDICATE CALCULUS (FOPC) KNOWLEDGE BASE & INFERENCE (TASK 3)
# ==============================================================================
class FOPCKnowledgeBase:
    def __init__(self):
        self.facts = set()
        self.rules = []

    def add_fact(self, pred, *args):
        self.facts.add((pred, args))

    def add_rule(self, name, head_pred, condition_fn):
        self.rules.append((name, head_pred, condition_fn))

    def forward_chain(self, entities):
        """Deduces all entailed assertions via Modus Ponens & Universal Instantiation."""
        derived_log = []
        changed = True
        while changed:
            changed = False
            for rname, head_pred, cond_fn in self.rules:
                for ent in entities:
                    if (head_pred, (ent,)) not in self.facts and cond_fn(self.facts, ent):
                        self.facts.add((head_pred, (ent,)))
                        derived_log.append(f"[{rname}] Derived {head_pred}({ent})")
                        changed = True
                for e1 in entities:
                    for e2 in entities:
                        if (head_pred, (e1, e2)) not in self.facts and cond_fn(self.facts, (e1, e2)):
                            self.facts.add((head_pred, (e1, e2)))
                            derived_log.append(f"[{rname}] Derived {head_pred}({e1}, {e2})")
                            changed = True
        return derived_log

    def query(self, pred, *args):
        if (pred, args) in self.facts:
            return "TRUE"
        if ("Not" + pred, args) in self.facts:
            return "FALSE"
        return "UNKNOWN (Open-World Assumption)"

