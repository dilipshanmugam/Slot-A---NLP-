    "qualifies":  LambdaExpr("x", "QualifiesForPension({x})"),
    "every":      lambda P: lambda Q: f"forall x. ({P.apply('x')} -> {Q.apply('x')})",
    "some":       lambda P: lambda Q: f"exists x. ({P.apply('x')} & {Q.apply('x')})",
