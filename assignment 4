class LambdaExpr:
    def __init__(self, var, body):
        self.var = var
        self.body = body

    def apply(self, arg):
        if callable(self.body):
            return self.body(arg)
        return self.body.replace(f"{{{self.var}}}", str(arg))

SEMANTIC_LEXICON = {
    "employee":   LambdaExpr("x", "Employee({x})"),
